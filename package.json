{
  "name": "ggf-geoportal",
  "version": "1.0.0",
  "description": "Green Gold Forestry Spatial Data Portal and Shapefile Hub",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "export:data": "node scripts/export-data.js",
    "build": "node scripts/export-data.js && npm --prefix client install && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "proj4": "^2.15.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
